# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=salon_admin
DB_PASSWORD=your-database-password-here
DB_NAME=salon
DB_SSLMODE=disable  # для production используйте 'require'

# Session Configuration
SESSION_SECURE=false  # установить в true для production с HTTPS
SESSION_SECRET=generate-random-secret-key-here-use-openssl-rand-base64-32

# CSRF Protection
# Generate with: openssl rand -base64 32
CSRF_AUTH_KEY=generate-random-32-byte-base64-key-here

# SMTP Configuration (для восстановления пароля)
# Gmail example (требуется App Password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password-here
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=ProminaYou Admin

# Application URL (для ссылок в письмах)
APP_URL=http://localhost:8004

# =============================================================================
# Setup Instructions for PostgreSQL
# =============================================================================
#
# Run these commands to set up the database:
#
# sudo -u postgres psql
#
# CREATE DATABASE salon;
# CREATE USER salon_admin WITH PASSWORD 'your-chosen-password';
# GRANT ALL PRIVILEGES ON DATABASE salon TO salon_admin;
# ALTER USER salon_admin CREATEDB;
# \q
#
# Then connect to verify:
# psql -h localhost -p 5432 -U salon_admin -d salon
#
# =============================================================================
# How to Generate Secure Keys
# =============================================================================
#
# SESSION_SECRET:
#   openssl rand -base64 32
#
# CSRF_AUTH_KEY:
#   openssl rand -base64 32
#
# Gmail App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification
#   3. Go to App Passwords
#   4. Generate password for "Mail" app
#   5. Copy the 16-character password
#
# =============================================================================
